{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-commit-authors": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "include-v-in-release-name": true,
  "separate-pull-requests": true,
  "exclude-paths": [
    ".git",
    ".idea",
    ".vscode"
  ],
  "changelog-sections": [
    { "type": "breaking", "section": "⛓️‍💥 Breaking Changes" },
    { "type": "feat", "section": "🚀 Enhancements" },
    { "type": "perf", "section": "🚀 Enhancements" },
    { "type": "fix", "section": "🩹 Fixes" },
    { "type": "docs", "section": "📖 Documentation" },
    { "type": "refactor", "section": "♻️ Refactoring" },
    { "type": "test", "section": "✅ Tests" },
    { "type": "build", "section": "🏗️ Build & Automation" },
    { "type": "ci", "section": "🏗️ Build & Automation" },
    { "type": "chore", "section": "🧹 Maintenance" },
    { "type": "revert", "section": "⏪ Reverts" }
  ],
  "packages": {
    ".": {
      "extra-files": [
        "src/TowerBridge.API/TowerBridge.API.csproj"
      ]
    }
  }
}
